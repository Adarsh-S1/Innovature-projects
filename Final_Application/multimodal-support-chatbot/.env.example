# ══════════════════════════════════════════════════════════════════════════
# Multimodal Support Chatbot — Environment Variables
# Copy this file to .env and fill in your values.
# ══════════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────────
APP_NAME="Multimodal Support Chatbot"
APP_VERSION="1.0.0"
DEBUG=true
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── API Server ───────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:5173"]
RATE_LIMIT_PER_MINUTE=60

# ── Authentication (leave empty to disable in dev) ───────────────────────
API_KEY=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# ── Text Models (Groq LLM + Local SentenceTransformers Embeddings) ──────
GROQ_API_KEY=gsk-your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant

# ── OpenAI (Legacy — not actively used, kept for LLM reranker fallback) ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── Local Embeddings (SentenceTransformers — used for text vectors) ──────
# NOTE: Despite the "OPENAI_" prefix (legacy naming), these settings
# configure the LOCAL SentenceTransformers model, NOT an OpenAI API.
OPENAI_EMBEDDING_MODEL=all-MiniLM-L6-v2
OPENAI_EMBEDDING_DIMENSIONS=384
OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT=60

# ── Google Gemini (Fallback LLM — optional) ──────────────────────────────
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# ── CLIP (Cross-modal image retrieval) ───────────────────────────────────
CLIP_MODEL_NAME=ViT-L/14
CLIP_DEVICE=cuda
CLIP_EMBEDDING_DIMENSIONS=768

# ── Milvus ───────────────────────────────────────────────────────────────
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DATABASE=default
MILVUS_TEXT_COLLECTION=text_collection
MILVUS_IMAGE_COLLECTION=image_collection

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SESSION_TTL_SECONDS=3600
REDIS_CACHE_TTL_SECONDS=300

# ── MinIO (S3-compatible) ────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=multimodal-chatbot
MINIO_SECURE=false
MINIO_PRESIGNED_URL_TTL=3600

# ── Ingestion Pipeline ──────────────────────────────────────────────────
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=128
MIN_IMAGE_WIDTH=100
MIN_IMAGE_HEIGHT=100
MAX_CAPTION_LENGTH=200
BATCH_EMBED_SIZE=32

# ── Retrieval ────────────────────────────────────────────────────────────
TEXT_SEARCH_TOP_K=20
TEXT_RERANK_TOP_K=5
IMAGE_SEARCH_TOP_K=10
IMAGE_RETURN_TOP_K=3
CLIP_SIMILARITY_THRESHOLD=0.25
CAPTION_SIMILARITY_THRESHOLD=0.70

# ── Quality Guard ────────────────────────────────────────────────────────
QUALITY_THRESHOLD=0.75
MAX_RETRIES=2

# ── Celery ───────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Observability ────────────────────────────────────────────────────────
OTEL_EXPORTER_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multimodal-chatbot
